{
	"name": "beacon",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm run typecheck && pnpm run minify-beacons && vite build",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "vite",
		"preview": "vite preview",
		"minify-beacons": "terser public/beacon.js -o public/beacon.min.js && terser public/exp-beacon.js -o public/exp-beacon.min.js",
		"test": "node --experimental-strip-types --test \"src/**/*.test.mjs\"",
		"typecheck": "tsc -b --pretty false",
		"db:apply": "wrangler d1 migrations apply analytics-database"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.17.0",
		"@cloudflare/workers-types": "4.20251202.0",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"terser": "5.44.1",
		"typescript": "5.9.3",
		"vite": "7.2.6",
		"wrangler": "4.53.0"
	},
	"dependencies": {
		"@sentry/cloudflare": "^10.55.0",
		"hono": "4.10.7",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-markdown": "10.1.0",
		"react-router": "7.10.1",
		"react-router-dom": "7.10.1",
		"remark-gfm": "4.0.1"
	}
}
